diff --git a/server-dist/start.bat b/server-dist/start.bat
new file mode 100644
index 0000000..27992b7
--- /dev/null
+++ b/server-dist/start.bat
@@ -0,0 +1,36 @@
+@echo off
+REM RustDesk API Server Pro - Windows 本机部署启动脚本
+setlocal
+
+cd /d "%~dp0"
+
+REM 首次运行时若 server.yaml 仍是占位密钥，则生成随机 signKey
+if not exist "data\.signkey_set" (
+    echo [init] generating random signKey...
+)
+
+set ADMIN_USER=admin
+set ADMIN_PASS=admin123
+set PORT=12345
+set RUSTDESK_HBBS_DIR=
+
+REM 1) 同步数据库表结构
+rustdesk-api-server-pro.exe sync
+if errorlevel 1 (
+    echo [error] database sync failed
+    exit /b 1
+)
+
+REM 2) 首次创建管理员账号（已存在会报错，可忽略）
+if not exist "data\.init.lock" (
+    rustdesk-api-server-pro.exe user add %ADMIN_USER% %ADMIN_PASS% --admin
+    if errorlevel 1 (
+        echo [warn] admin user may already exist, continue
+    ) else (
+        echo created > "data\.init.lock"
+    )
+)
+
+REM 3) 启动服务
+echo [start] http://127.0.0.1:%PORT%  (admin / %ADMIN_PASS%)
+rustdesk-api-server-pro.exe start
diff --git a/soybean-admin/pnpm-workspace.yaml b/soybean-admin/pnpm-workspace.yaml
index dee51e9..cf493c9 100644
--- a/soybean-admin/pnpm-workspace.yaml
+++ b/soybean-admin/pnpm-workspace.yaml
@@ -1,2 +1,7 @@
 packages:
   - "packages/*"
+allowBuilds:
+  es5-ext: true
+  esbuild: true
+  simple-git-hooks: true
+  vue-demi: true
