+        let params = KxParams {
+            pk: our_pk_b.0.to_vec().into(),
+            version: 0,
+            ..Default::default()
+        };
+        let mut payload = hbb_common::tcp::KX_PARAMS_DOMAIN.to_vec();
+        payload.extend_from_slice(&params.write_to_bytes().unwrap_or_default());
+        let msg_out = RendezvousMessage {
+            union: Some(rendezvous_message::Union::KeyExchange(KeyExchange {
+                keys: vec![sign::sign(&our_pk_b.0, sk).into()],
+                version: 0,
+                signed_params: sign::sign(&payload, sk).into(),
+                ..Default::default()
+            })),
+            ..Default::default()
