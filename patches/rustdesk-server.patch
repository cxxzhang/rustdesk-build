@@ -1,4 +1,5 @@
 use bytes::{Buf, BufMut, Bytes, BytesMut};
+use sodiumoxide::crypto::secretbox;
 use std::io;
 use tokio_util::codec::{Decoder, Encoder};
 
@@ -10,6 +11,55 @@ pub struct BytesCodec {
     state: DecodeState,
     raw: bool,
     max_packet_length: usize,
+    // Both directions of the rendezvous key exchange. A peer that runs it (the connections that
+    // carry the WebRTC answer and ICE candidates do, see rustdesk `secure_tcp_required`) encrypts
+    // everything it sends from then on and expects everything it receives the same way. The frame
+    // body has to be opened and sealed here, in the codec, so the nonce counters advance exactly
+    // as the peer's do.
+    decrypt: Option<Crypt>,
+    encrypt: Option<Crypt>,
+}
+
+/// One direction of a rendezvous key exchange, matching `Encrypt` in `tcp.rs`: same key and nonce
+/// layout. The key is kept as bytes rather than a `secretbox::Key` so this stays `Copy`, which
+/// `BytesCodec` is.
+#[derive(Debug, Clone, Copy)]
+struct Crypt {
+    key: [u8; secretbox::KEYBYTES],
+    seq: u64,
+}
+
+impl Crypt {
+    fn open(&mut self, bytes: &mut BytesMut) -> io::Result<()> {
+        // An empty frame is left as-is: the counter only advances for a body that is there,
+        // and `Encrypt::dec` skips the same case.
+        if bytes.len() <= 1 {
+            return Ok(());
+        }
+        self.seq += 1;
+        match secretbox::open(bytes, &self.nonce(), &secretbox::Key(self.key)) {
+            Ok(plain) => {
+                bytes.clear();
+                bytes.put_slice(&plain);
+                Ok(())
+            }
+            Err(()) => Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "decryption error",
+            )),
+        }
+    }
+
+    fn seal(&mut self, data: &[u8]) -> Vec<u8> {
+        self.seq += 1;
+        secretbox::seal(data, &self.nonce(), &secretbox::Key(self.key))
+    }
+
+    fn nonce(&self) -> secretbox::Nonce {
+        let mut nonce = secretbox::Nonce([0u8; secretbox::NONCEBYTES]);
+        nonce.0[..std::mem::size_of_val(&self.seq)].copy_from_slice(&self.seq.to_le_bytes());
+        nonce
+    }
 }
 
 #[derive(Debug, Clone, Copy)]
@@ -30,9 +80,22 @@ impl BytesCodec {
             state: DecodeState::Head,
             raw: false,
             max_packet_length: usize::MAX,
+            decrypt: None,
+            encrypt: None,
         }
     }
 
+    /// Turn on both directions of the key exchange with `key`, for a peer that secured this
+    /// connection. Nothing is sent before this is called, so the send counter starts at zero.
+    pub fn set_crypt_key(&mut self, key: secretbox::Key) {
+        let crypt = Crypt {
+            key: key.0,
+            seq: 0,
+        };
+        self.decrypt = Some(crypt);
+        self.encrypt = Some(crypt);
+    }
+
     pub fn set_raw(&mut self) {
         self.raw = true;
     }
